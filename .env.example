# ==========================================
# PML HOTEL — ENVIRONMENT VARIABLES
# ==========================================

# 1. Neon PostgreSQL Database Connection (Bắt buộc)
# Lấy connection string từ Neon Console (hỗ trợ pooler hoặc direct)
DATABASE_URL="postgres://username:password@ep-example-pooler.region.neon.tech/neondb?sslmode=require"

# 2. Google Gemini API (Bắt buộc cho AI Concierge & Chatbot)
# Lấy API Key từ https://aistudio.google.com/
GEMINI_API_KEY="AIzaSy..."

# (Tùy chọn) Chọn model Gemini ưu tiên: gemini-3.8-flash (mặc định), gemini-3.5-flash-lite, gemini-3.5-flash
GEMINI_MODEL="gemini-3.8-flash"

# (Tùy chọn) Giới hạn số câu hỏi AI Chatbot phục vụ mỗi tháng (Mặc định: 10000 tin)
MONTHLY_AI_MESSAGE_LIMIT=10000

# 3. VietQR & Cổng thanh toán chuyển khoản ngân hàng (Tùy chọn)
VIETQR_BANK_ID="MB"
VIETQR_ACCOUNT_NO="0789780167"
VIETQR_ACCOUNT_NAME="PML BOUTIQUE HOTEL"

# 4. Thông báo Zalo tức thì tới Lễ tân (Khi có SĐT từ AI Chatbot / Đặt phòng mới)
# Cách 1 (Phổ biến & tiện dụng nhất): Webhook gửi vào Nhóm Zalo nội bộ của Lễ tân
ZALO_WEBHOOK_URL="https://your-zalo-webhook-url.com/api/notify"

# Cách 2: Zalo Official Account (OA) / ZNS
# ZALO_OA_ACCESS_TOKEN="your_zalo_oa_token"
# RECEPTION_ZALO_USER_ID="user_id_zalo_receptionist"

